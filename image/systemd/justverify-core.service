[Unit]
Requires=justverify-backup.service
After=justverify-backup.service
StartLimitIntervalSec=60
StartLimitBurst=3
Description=JustVerify Bitcoin Core
After=network-online.target justverify-firstboot.service
Wants=network-online.target justverify-i2p.service justverify-tor.service
After=justverify-i2p.service justverify-tor.service
RequiresMountsFor=/srv/justverify/data
ConditionPathIsMountPoint=/srv/justverify/data

ConditionPathExists=/etc/justverify/node-ready.json

[Service]
User=justverify
Group=justverify
ExecStartPre=/usr/bin/python3 /opt/justverify/scripts/node_ready.py
ExecStart=/usr/bin/python3 -I /opt/justverify/scripts/core_service.py
Restart=on-failure
RestartSec=30
TimeoutStopSec=900
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/justverify/data/core
UMask=0077

[Install]
WantedBy=multi-user.target

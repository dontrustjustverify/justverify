[Unit]
Requires=justverify-backup.service
After=justverify-backup.service
Description=JustVerify Electrum indexer
After=justverify-firstboot.service justverify-core.service
Wants=justverify-core.service
RequiresMountsFor=/srv/justverify/data
ConditionPathIsMountPoint=/srv/justverify/data
StartLimitIntervalSec=60
StartLimitBurst=3

ConditionPathExists=/etc/justverify/node-ready.json

[Service]
User=justverify
Group=justverify
ExecStartPre=/usr/bin/python3 /opt/justverify/scripts/node_ready.py
ExecStartPre=/usr/bin/python3 /opt/justverify/scripts/wait_core_rpc.py
TimeoutStartSec=150
ExecStart=/usr/bin/python3 /opt/justverify/scripts/electrs_service.py
LimitNOFILE=65536
RuntimeDirectory=justverify-electrs
RuntimeDirectoryMode=0750
Restart=on-failure
RestartSec=30
TimeoutStopSec=900
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/justverify/data/electrs
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077

[Install]
WantedBy=multi-user.target

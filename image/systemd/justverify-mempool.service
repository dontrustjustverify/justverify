[Unit]
Description=JustVerify bundled mempool backend and private database
After=justverify-firstboot.service justverify-core.service justverify-electrs.service justverify-mempool-web.service
Wants=justverify-mempool-web.service
Requires=justverify-mempool-data.service
After=justverify-mempool-data.service
RequiresMountsFor=/srv/justverify/data
ConditionPathIsMountPoint=/srv/justverify/data
ConditionPathExists=/etc/justverify/node-ready.json

[Service]
User=justverify
Group=justverify
RuntimeDirectory=justverify-mempool
RuntimeDirectoryMode=0700
ExecStartPre=/usr/bin/python3 /opt/justverify/scripts/node_ready.py
ExecStart=/usr/bin/python3 /opt/justverify/scripts/mempool_service.py
Restart=on-failure
RestartSec=10
TimeoutStopSec=210
KillMode=mixed
MemoryHigh=1400M
MemoryMax=1800M
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/justverify/data/mempool /run/justverify-mempool
InaccessiblePaths=/var/lib/justverify/web /var/lib/tor /var/lib/justverify-tor /root
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077

[Install]
WantedBy=multi-user.target
